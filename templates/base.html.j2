<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Cat Goes Fishing — Field Guide</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&family=Nunito+Sans:ital,wght@0,400;0,600;0,700;1,600&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
  :root {
    --paper: #f6f0e1; --paper2: #efe6d0; --ink: #17241a; --ink-soft: #3c4a3d;
    --deep: #0c3a20; --deep2: #0f4d29; --kelp: #2fae4a; --seafoam: #d9f5d4;
    --gold: #cf9a3d; --gold-soft: #eddcb3; --coral: #e0512f; --navy: #12496b;
    --line: rgba(23,36,26,0.14);
    --shadow: 0 18px 40px -14px rgba(12,58,32,0.35), 0 2px 8px rgba(12,58,32,0.12);
  }
  * { box-sizing: border-box; }
  body { margin:0; background:#dcd3ba;
    background-image: radial-gradient(circle at 15% 10%, rgba(255,255,255,0.35), transparent 45%), radial-gradient(circle at 85% 90%, rgba(255,255,255,0.25), transparent 45%);
    font-family:'Nunito Sans',sans-serif; color:var(--ink); padding:36px 16px 80px; }
  .wrap { max-width:900px; margin:0 auto; }
  .intro { text-align:center; margin-bottom:34px; }
  .intro .kicker { font-family:'Space Mono',monospace; font-size:11px; letter-spacing:0.12em; text-transform:uppercase; color:#6b5a3a; margin-bottom:8px; }
  .intro h1 { font-family:'Baloo 2',sans-serif; font-size:32px; color:var(--deep); margin:0 0 10px; }
  .intro p { max-width:620px; margin:0 auto; font-size:14.5px; line-height:1.6; color:var(--ink-soft); }
  .layout-tag { font-family:'Space Mono',monospace; font-size:12px; letter-spacing:0.08em; text-transform:uppercase; color:var(--deep); margin: 44px 0 6px; display:flex; align-items:center; gap:9px; }
  .layout-tag .n { background:var(--deep); color:#fff; width:22px; height:22px; border-radius:50%; display:inline-flex; align-items:center; justify-content:center; font-size:11px; }
  .layout-sub { font-size:12.5px; color:var(--ink-soft); font-style:italic; margin:0 0 14px; }
  .page { background:var(--paper); border-radius:14px; box-shadow:var(--shadow); position:relative; overflow:hidden; border:1px solid rgba(23,36,26,0.08); margin-bottom:28px; }
  .page::before { content:""; position:absolute; inset:0; background-image: repeating-linear-gradient(0deg, transparent, transparent 27px, rgba(23,36,26,0.025) 27px, rgba(23,36,26,0.025) 28px); pointer-events:none; }
  .tape { position:absolute; top:-10px; left:28px; width:74px; height:26px; background:linear-gradient(180deg, rgba(255,255,255,0.55), rgba(255,255,255,0.28)); border:1px solid rgba(255,255,255,0.5); transform:rotate(-4deg); box-shadow:0 4px 10px rgba(0,0,0,0.12); }
  .banner { display:flex; align-items:center; justify-content:space-between; gap:14px; padding:18px 24px; background:linear-gradient(100deg, var(--deep), var(--deep2) 60%, var(--kelp)); position:relative; z-index:1; }
  .banner::after { content:""; position:absolute; left:0; right:0; bottom:-7px; height:7px; background:repeating-linear-gradient(-45deg, var(--gold) 0 8px, var(--gold-soft) 8px 16px); }
  .banner h2 { font-family:'Baloo 2',sans-serif; color:#fff; font-size:28px; margin:0; letter-spacing:0.01em; text-shadow:0 2px 0 rgba(0,0,0,0.15); }
  .banner .sub { font-family:'Space Mono',monospace; color:var(--seafoam); font-size:11px; letter-spacing:0.08em; text-transform:uppercase; margin-top:3px; opacity:0.9; }
  .badge-col { display:flex; flex-direction:column; gap:6px; align-items:flex-end; }
  .badge { font-family:'Space Mono',monospace; font-size:10.5px; letter-spacing:0.06em; text-transform:uppercase; padding:4px 10px; border-radius:999px; white-space:nowrap; }
  .badge.cat { background:var(--seafoam); color:var(--deep); }
  .badge.diff-easy { background:#cdeccd; color:#1f5c2c; }
  .badge.diff-mod { background:#f6e2ad; color:#7a5a12; }
  .badge.diff-hard { background:#f3c3b9; color:#8a2c17; }
  .cast-strip { display:flex; align-items:center; gap:10px; background:var(--gold-soft); border-top:1px dashed var(--gold); border-bottom:1px dashed var(--gold); padding:9px 24px; font-family:'Space Mono',monospace; font-size:12.5px; color:#6b4e14; position:relative; z-index:1; }
  .cast-strip b { color:#4a3305; text-transform:uppercase; letter-spacing:0.05em; }
  /* World map: pan/zoom in place, and every fish on it is tappable. */
  .world-map { cursor:grab; touch-action:none; }
  .world-map.is-dragging { cursor:grabbing; }
  .world-map .map-crop { transform:none; }
  .world-bar { display:flex; align-items:center; gap:12px; flex-wrap:wrap; margin-top:9px; }
  .world-hint { font-family:'Space Mono',monospace; font-size:10px; letter-spacing:0.05em;
    text-transform:uppercase; color:var(--ink-soft); }
  .world-zoom { display:flex; gap:6px; margin-left:auto; }
  .world-zoom button { font-family:'Space Mono',monospace; font-size:11px; letter-spacing:0.05em;
    text-transform:uppercase; color:var(--ink); background:transparent;
    border:1px solid var(--line); border-radius:7px; padding:6px 11px; cursor:pointer; }
  .world-zoom button:hover { background:var(--paper2); }
  .fish-marker[data-fish] { cursor:pointer; }
  .fish-sel { pointer-events:none; }

  /* Fish card: one sheet, shared by the world map and the detail view. */
  .fc { position:fixed; left:0; right:0; bottom:0; z-index:130; background:var(--paper);
    border-radius:18px 18px 0 0; box-shadow:0 -14px 40px -12px rgba(0,0,0,0.55);
    padding:0 0 calc(14px + env(safe-area-inset-bottom, 0px)); display:none;
    max-height:76vh; overflow:auto; touch-action:pan-y; }
  .fc[open] { display:block; }
  .fc-grab { width:38px; height:4px; border-radius:99px; background:var(--line); margin:9px auto 4px; }
  .fc-head { display:flex; align-items:baseline; gap:10px; padding:6px 16px 0; flex-wrap:wrap; }
  .fc-name { font-family:'Baloo 2',sans-serif; font-weight:700; font-size:21px; color:var(--deep); }
  .fc-size { font-family:'Space Mono',monospace; font-size:9.5px; letter-spacing:0.09em;
    text-transform:uppercase; color:var(--ink-soft); }
  .fc-where { font-family:'Space Mono',monospace; font-size:9.5px; letter-spacing:0.06em;
    text-transform:uppercase; color:var(--ink-soft); margin-left:auto; }
  .fc-body { display:flex; gap:14px; padding:10px 16px 0; align-items:flex-start; }
  .fc-pic { flex:none; width:104px; height:78px; background:var(--paper2); border:1px solid var(--line);
    border-radius:10px; display:grid; place-items:center; overflow:hidden; }
  .fc-pic svg { width:88%; height:88%; }
  .fc-about { font-size:14.5px; line-height:1.55; color:var(--ink-soft); margin:0; }
  .fc-stats { display:flex; flex-wrap:wrap; gap:8px; padding:11px 16px 0; font-size:12.5px; }
  .fc-stats span { background:rgba(23,36,26,0.06); border-radius:7px; padding:5px 9px; }
  .fc-nav { display:flex; align-items:center; gap:10px; padding:12px 16px 2px; }
  .fc-nav { flex-wrap:wrap; }
  .fc-nav button[data-fc="prev"], .fc-nav button[data-fc="next"] {
    font-family:'Space Mono',monospace; font-size:12px; color:var(--ink);
    background:transparent; border:1px solid var(--line); border-radius:999px;
    width:34px; height:34px; flex:none; cursor:pointer; }
  .fc-nav button:disabled { opacity:0.35; cursor:default; }
  .fc-count { font-family:'Space Mono',monospace; font-size:10.5px; letter-spacing:0.08em;
    text-transform:uppercase; color:var(--ink-soft); }
  .fc-done { margin-left:auto; flex:none; white-space:nowrap; font-family:'Space Mono',monospace; font-size:11px;
    letter-spacing:0.08em; text-transform:uppercase; color:var(--ink); background:transparent;
    border:1px solid var(--line); border-radius:999px; padding:8px 16px; cursor:pointer; }
  .mv[open] .fc { z-index:140; }
  .mv .mv-world { aspect-ratio:auto !important; height:min(66vh, 560px); }
  .mv .world-bar { margin-top:11px; }
  .mv .world-hint { color:rgba(246,240,225,0.7); }
  .mv .world-zoom button { color:var(--paper); border-color:rgba(255,255,255,0.3); }
  .mv .world-zoom button:hover { background:rgba(255,255,255,0.12); }
  /* Full-screen map detail view. Opened by tapping a map or its
     context strip; closed by the bottom bar, a downward swipe, Esc, or
     the back gesture -- several ways out on purpose, since the bar is
     the discoverable one and the swipe is the one a phone reader
     reaches for first. Print never sees any of it. */
  .map-frame, .ctx { cursor:zoom-in; }
  .mv { position:fixed; inset:0; z-index:120; display:none; }
  .mv[open] { display:flex; flex-direction:column; }
  .mv-scrim { position:absolute; inset:0; background:rgba(7,22,14,0.90); }
  .mv-stage { position:relative; flex:1; display:flex; flex-direction:column;
    align-items:center; justify-content:center; gap:10px; padding:18px 14px 76px;
    transform-origin:center; touch-action:none; }
  .mv-inner { width:100%; max-width:900px; }
  .mv-inner .ctx, .mv-inner .map-frame { max-width:none; margin:0; cursor:default; }
  .mv-inner .ctx-link { height:26px; }
  .mv-grab { width:44px; height:5px; border-radius:99px; background:rgba(246,240,225,0.5); flex:none; }
  .mv-bar { position:absolute; left:0; right:0; bottom:0; display:flex; justify-content:center;
    padding:14px 16px calc(14px + env(safe-area-inset-bottom, 0px));
    background:rgba(7,22,14,0.94); border-top:1px solid rgba(255,255,255,0.16); }
  .mv-close { font-family:'Space Mono',monospace; font-size:12px; letter-spacing:0.09em;
    text-transform:uppercase; color:var(--paper); background:transparent;
    border:1px solid rgba(255,255,255,0.34); border-radius:999px; padding:10px 22px; cursor:pointer; }
  .mv-close:hover { background:rgba(255,255,255,0.10); }
  body.mv-open { overflow:hidden; }
  @media (prefers-reduced-motion:no-preference) {
    .mv-stage { transition:transform 0.24s ease, opacity 0.24s ease; }
  }
  /* Every map is the same world map, pointed somewhere. The shared
     layer holds every fish in the book; a group's own fish are redrawn
     on top of it at full strength, because a shared layer cannot know
     whose page it is on. */
  #allFish .fish-marker { opacity:0.34; }
  .map-frame { cursor:grab; touch-action:none; }
  .map-frame.is-dragging { cursor:grabbing; }
  /* A fish picture only receives a click where it is actually painted,
     so a tap on the transparent corner of one fish falls through to
     whatever is behind it. Make the whole marker box clickable, and
     keep the decorative rings out of the way entirely. */
  .own .fish-marker { pointer-events:all; }
  .own-ring { fill:none; stroke:var(--gold); stroke-width:1.6; opacity:0.9; pointer-events:none; }
  .fish-sel { fill:none; stroke:var(--gold); stroke-width:2.4; pointer-events:none; }
  .map-bar { display:flex; align-items:center; gap:10px; flex-wrap:wrap; margin-top:9px; }
  .map-hint { font-family:'Space Mono',monospace; font-size:10px; letter-spacing:0.05em;
    text-transform:uppercase; color:var(--ink-soft); }
  .map-zoom { display:flex; gap:6px; margin-left:auto; }
  .map-zoom button { font-family:'Space Mono',monospace; font-size:11px; letter-spacing:0.05em;
    text-transform:uppercase; color:var(--ink); background:transparent;
    border:1px solid var(--line); border-radius:7px; padding:6px 10px; cursor:pointer; }
  .map-zoom button:hover { background:var(--paper2); }
  .mv .map-hint { color:rgba(246,240,225,0.7); }
  .mv .map-zoom button { color:var(--paper); border-color:rgba(255,255,255,0.3); }
  .mv .map-zoom button:hover { background:rgba(255,255,255,0.12); }
  /* Context strip: the whole world above a group's crop, with this
     page's slice marked and guide lines down to the detail map. The
     .ctx box must match the .map-frame's own width/centering per
     layout below, or the guide lines land nowhere near the map. */
  .ctx { line-height:0; margin-bottom:0; }
  .ctx-map { display:block; width:100%; height:auto; background:#0c3a20; border:2px solid var(--deep); border-radius:7px; font-family:'Trebuchet MS','Segoe UI',Verdana,sans-serif; }
  .ctx-box { fill:rgba(207,154,61,0.30); stroke:var(--gold); stroke-width:7; }
  .ctx-link { display:block; width:100%; height:20px; overflow:visible; }
  .ctx-link polygon { fill:rgba(207,154,61,0.28); }
  .ctx-link path { fill:none; stroke:var(--gold); stroke-width:1.2; vector-effect:non-scaling-stroke; opacity:0.75; }
  .map-crop { width:100%; height:100%; display:block; background:#0c3a20; font-family:'Trebuchet MS','Segoe UI',Verdana,sans-serif; }
  .map-frame { border:3px solid var(--deep); border-radius:10px; overflow:hidden; box-shadow:inset 0 0 0 1px rgba(255,255,255,0.15); position:relative; background:#0c3a20; line-height:0; }
  .gear-list { list-style:none; margin:0; padding:0; display:grid; gap:7px; }
  .gear-list li { display:flex; align-items:center; gap:9px; font-size:13.5px; background:rgba(23,36,26,0.05); border-radius:8px; padding:7px 10px; }
  .gear-list .ic { font-size:16px; width:20px; text-align:center; }
  .game-icon { height:1em; width:auto; vertical-align:-0.15em; }
  .gear-list .must { margin-left:auto; font-family:'Space Mono',monospace; font-size:9.5px; background:var(--coral); color:#fff; padding:2px 7px; border-radius:999px; letter-spacing:0.04em; }
  h3.section-h { font-family:'Baloo 2',sans-serif; font-size:14.5px; color:var(--deep); text-transform:uppercase; letter-spacing:0.04em; margin:0 0 9px; display:flex; align-items:center; gap:7px; }
  h3.section-h::before { content:""; width:16px; height:3px; background:var(--gold); border-radius:2px; display:inline-block; }
  p.desc { font-size:14px; line-height:1.6; color:var(--ink); margin:0 0 14px; }
  p.instr { font-size:13.5px; line-height:1.6; color:var(--ink-soft); margin:0; background:rgba(47,174,74,0.08); border-left:3px solid var(--kelp); padding:10px 12px; border-radius:0 8px 8px 0; }
  .l1-body { position:relative; z-index:1; padding:22px 24px 26px; display:grid; grid-template-columns:1.05fr 0.95fr; gap:26px; }
  .l1-map .map-frame { aspect-ratio:220/251; }
  .l1-map .ctx { max-width:none; }
  .l1-text { display:flex; flex-direction:column; gap:16px; }
  @media (max-width:640px) { .l1-body { grid-template-columns:1fr; } }
  .l2-body { position:relative; z-index:1; padding:22px 24px 26px; }
  .l2-map .map-frame { aspect-ratio:380/251; max-width:640px; margin:0 auto; }
  .l2-map .ctx { max-width:640px; margin:0 auto; }
  .l2-map { margin-bottom:18px; }
  .duo-grid { display:grid; grid-template-columns:1fr 1fr; gap:16px; }
  .duo-card { background:rgba(255,255,255,0.5); border-radius:10px; padding:14px 16px; border:1px solid var(--line); }
  .duo-card .who { display:flex; align-items:center; gap:8px; margin-bottom:6px; }
  .duo-card h4 { font-family:'Baloo 2',sans-serif; margin:0; font-size:16px; color:var(--deep); }
  .duo-card p { font-size:12.8px; line-height:1.5; margin:0; color:var(--ink-soft); }
  .shared-gear { margin-top:16px; }
  @media (max-width:640px) { .duo-grid { grid-template-columns:1fr; } }
  .l3-body { position:relative; z-index:1; padding:22px 24px 26px; }
  .l3-map .map-frame { max-width:340px; margin:0 auto 6px; }
  .l3-map .ctx { max-width:340px; margin:0 auto; }
  .l3-maplabel { text-align:center; font-family:'Space Mono',monospace; font-size:11px; color:var(--ink-soft); margin-bottom:18px; }
  .dex-grid { display:grid; grid-template-columns:repeat(5,1fr); gap:10px; }
  .dex-grid.cols4 { grid-template-columns:repeat(4,1fr); }
  .dex-card { background:rgba(255,255,255,0.55); border:1px solid var(--line); border-radius:10px; padding:10px 8px; text-align:center; }
  .dex-card .pin { width:22px; height:22px; border-radius:50%; background:var(--navy); color:#fff; display:flex; align-items:center; justify-content:center; margin:0 auto 6px; font-family:'Space Mono',monospace; font-size:11px; font-weight:700; border:2px solid #fff; box-shadow:0 0 0 1px rgba(0,0,0,0.15); }
  .dex-card h5 { font-family:'Baloo 2',sans-serif; font-size:12.5px; margin:0 0 4px; color:var(--deep); line-height:1.15; }
  .dex-card p { font-size:10.8px; line-height:1.35; color:var(--ink-soft); margin:0; }
  .dex-footer { margin-top:16px; display:flex; gap:18px; flex-wrap:wrap; }
  @media (max-width:700px) { .dex-grid { grid-template-columns:repeat(2,1fr); } }

  /* ---------- Fuller entry cards (fish write-ups on the same page) ---------- */
  .entry-card { background:rgba(255,255,255,0.55); border:1px solid var(--line); border-radius:10px; padding:13px 14px; text-align:left; }
  .entry-card .head { display:flex; align-items:center; gap:8px; margin-bottom:7px; }
  .entry-card .pin { width:24px; height:24px; border-radius:50%; background:var(--navy); color:#fff; display:flex; align-items:center; justify-content:center; font-family:'Space Mono',monospace; font-size:11px; font-weight:700; border:2px solid #fff; box-shadow:0 0 0 1px rgba(0,0,0,0.15); flex-shrink:0; }
  .entry-card h5 { font-family:'Baloo 2',sans-serif; font-size:14.5px; margin:0; color:var(--deep); }
  .entry-card p { font-size:11.8px; line-height:1.5; color:var(--ink-soft); margin:0 0 7px; }
  .entry-card .tip-label { font-family:'Space Mono',monospace; font-size:9px; text-transform:uppercase; letter-spacing:0.05em; color:#1f7a3d; font-weight:700; display:block; margin-bottom:2px; }
  .stat-row { display:flex; gap:10px; flex-wrap:wrap; font-family:'Space Mono',monospace; font-size:9.5px; color:var(--ink-soft); margin-top:8px; padding-top:8px; border-top:1px dashed var(--line); }
  .stat-row b { color:var(--deep); }
  .entry-grid3 { display:grid; grid-template-columns:repeat(3,1fr); gap:12px; }
  @media (max-width:700px) { .entry-grid3 { grid-template-columns:repeat(2,1fr); } .dex-grid.cols4 { grid-template-columns:repeat(2,1fr); } }
  .duo-card .stat-row { font-size:10px; }

  /* ---------- Continuation page (no map, spillover entries) ---------- */
  .cont-banner { display:flex; align-items:center; gap:10px; padding:16px 24px; background:linear-gradient(100deg, var(--deep), var(--deep2) 60%, var(--kelp)); position:relative; z-index:1; }
  .cont-banner::after { content:""; position:absolute; left:0; right:0; bottom:-7px; height:7px; background:repeating-linear-gradient(-45deg, var(--gold) 0 8px, var(--gold-soft) 8px 16px); }
  .cont-banner .arrow { font-size:20px; color:var(--seafoam); }
  .cont-banner h2 { font-family:'Baloo 2',sans-serif; color:#fff; font-size:20px; margin:0; }
  .cont-banner .sub { font-family:'Space Mono',monospace; color:var(--seafoam); font-size:10.5px; letter-spacing:0.06em; text-transform:uppercase; opacity:0.9; margin-top:2px; }
  .l4-body { position:relative; z-index:1; padding:22px 24px 26px; }

  /* ---------- Fish portraits (consistent 4:3 frame everywhere) ---------- */
  .fish-pic { width:100%; aspect-ratio:4/3; background:linear-gradient(160deg, rgba(255,255,255,0.7), rgba(217,207,176,0.45)); border:1px solid var(--line); border-radius:8px; margin-bottom:9px; overflow:hidden; display:flex; align-items:center; justify-content:center; }
  .fish-pic svg { width:100%; height:100%; display:block; }
  .fish-pic img { width:100%; height:100%; display:block; object-fit:contain; }
  .swatch { width:14px; height:14px; flex-shrink:0; display:inline-block; overflow:visible; }

  /* ---------- Fish Index ---------- */
  .index-body { position:relative; z-index:1; padding:22px 24px 26px; }
  .index-size-head { display:flex; align-items:center; gap:9px; margin:22px 0 10px; }
  .index-size-head:first-child { margin-top:0; }
  .index-size-pill { font-family:'Space Mono',monospace; font-size:11px; letter-spacing:0.06em; text-transform:uppercase; padding:4px 12px; border-radius:999px; font-weight:700; }
  .index-size-count { font-family:'Space Mono',monospace; font-size:11px; color:var(--ink-soft); }
  .index-list { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:8px; }
  @media (max-width:640px) { .index-list { grid-template-columns:minmax(0,1fr); } }
  .index-row { display:flex; align-items:center; gap:10px; background:rgba(255,255,255,0.55); border:1px solid var(--line); border-radius:8px; padding:6px 10px 6px 6px; border-left:4px solid var(--line); text-decoration:none; color:inherit; cursor:pointer; transition:background 0.15s; }
  .index-row:hover { background:rgba(255,255,255,0.85); }
  .index-thumb { width:50px; height:37.5px; flex-shrink:0; border-radius:6px; overflow:hidden; background:linear-gradient(160deg, rgba(255,255,255,0.7), rgba(217,207,176,0.45)); border:1px solid var(--line); }
  .index-thumb svg { width:100%; height:100%; display:block; }
  .index-thumb img { width:100%; height:100%; display:block; object-fit:contain; }
  .index-name { font-family:'Baloo 2',sans-serif; font-size:14px; color:var(--deep); flex:1; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .index-page-tag { font-family:'Space Mono',monospace; font-size:10px; background:var(--navy); color:#fff; padding:3px 9px; border-radius:999px; letter-spacing:0.03em; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:40%; flex-shrink:1; }
  .tier-flag { position:absolute; top:14px; right:16px; z-index:2; font-family:'Space Mono',monospace; font-size:10px; letter-spacing:0.06em; text-transform:uppercase; background:rgba(255,255,255,0.85); color:var(--deep); padding:4px 10px; border-radius:999px; border:1px solid var(--line); }
  .footnote { text-align:center; font-size:12px; color:var(--ink-soft); margin-top:46px; padding-top:18px; border-top:1px dashed rgba(23,36,26,0.25); line-height:1.6; }
  .footnote a { color:var(--deep); }
  .back-to-top { text-align:right; margin-top:14px; }
  .back-to-top a { font-family:'Space Mono',monospace; font-size:11px; letter-spacing:0.04em; text-transform:uppercase; color:var(--ink-soft); text-decoration:none; }
  .back-to-top a:hover { color:var(--deep); text-decoration:underline; }

  /* ---------- Print: one .page per sheet, no screen-only chrome ---------- */
  @media print {
    body { background:none; padding:0; }
    .wrap { max-width:none; }
    .page { break-after:page; box-shadow:none; border:none; border-radius:0; margin-bottom:0; }
    .page::before, .tape { display:none; }
    .footnote, .back-to-top, .mv, .fc, .world-bar, .map-bar { display:none !important; }
    .entry-card, .duo-card, .dex-card, .index-row { break-inside:avoid; }
  }
</style>
</head>
<body id="top">
<div class="wrap">
{{ content }}
  <div class="footnote">
    Map data traced from the community world map &amp; fishing notes for <i>Cat Goes Fishing</i>.<br>
    Marker placement is illustrative until checked page-by-page against the full guide before print.
  </div>
</div>

<div class="fc" id="fish-card" role="dialog" aria-label="Fish details">
  <div class="fc-grab"></div>
  <div class="fc-head"><span class="fc-name"></span><span class="fc-size"></span><span class="fc-where"></span></div>
  <div class="fc-body">
    <div class="fc-pic"><svg viewBox="0 0 10 10"><use></use></svg></div>
    <p class="fc-about"></p>
  </div>
  <div class="fc-stats"></div>
  <div class="fc-nav">
    <button type="button" data-fc="prev" aria-label="Previous fish">&#8592;</button>
    <button type="button" data-fc="next" aria-label="Next fish">&#8594;</button>
    <span class="fc-count"></span>
    <button type="button" class="fc-done" data-fc="close">Close</button>
  </div>
</div>
<div class="mv" id="map-view" role="dialog" aria-modal="true" aria-label="Map detail">
  <div class="mv-scrim" data-mv-close></div>
  <div class="mv-stage"><div class="mv-grab"></div><div class="mv-inner"></div></div>
  <div class="mv-bar"><button type="button" class="mv-close" data-mv-close>Done &middot; back to the fish</button></div>
</div>
{{ map_defs }}
<script>
// The back link normally returns you to wherever you jumped from --
// usually the index row you clicked -- rather than the top of the
// document, which is several hundred entries away from it. Falls back
// to its plain href="#top" when nothing has been jumped from yet
// (a direct load, or a reader who scrolled here by hand).
(function () {
  var origin = null;
  var links = function () { return document.querySelectorAll('a[data-back]'); };
  function relabel(text) {
    links().forEach(function (a) { a.textContent = text; });
  }
  document.addEventListener('click', function (e) {
    var a = e.target.closest ? e.target.closest('a[href^="#"]') : null;
    if (!a) return;
    if (a.hasAttribute('data-back')) {
      if (origin === null) return;  // let href="#top" happen
      e.preventDefault();
      window.scrollTo({ top: origin, behavior: 'smooth' });
      origin = null;
      relabel('\u2191 Back to top');
      return;
    }
    origin = window.scrollY;
    relabel('\u2191 Back');
  });
})();
</script>
<script>
// Tapping a map (or the context strip above it) opens both full screen,
// so you can read the crop without the page around it. Ways back out:
// the bottom bar, a downward swipe, Esc, and the browser's own back --
// deliberately several, because the bar is the one people see and the
// swipe is the one they try. Never a bare click on the map itself: that
// would fire every time you meant to look at a fish.
(function () {
  var mv = document.getElementById('map-view');
  if (!mv) return;
  var inner = mv.querySelector('.mv-inner');
  var stage = mv.querySelector('.mv-stage');
  var origin = null;

  function open(frame) {
    // Clone the map and the pieces that belong with it -- the context
    // strip above, the zoom bar below -- rather than the whole page
    // column, which on the overview page also holds body copy.
    var parts = [];
    var before = frame.previousElementSibling;
    if (before && before.classList.contains('ctx')) parts.push(before.cloneNode(true));
    var copy = frame.cloneNode(true);
    copy.removeAttribute('id');  // one #world-map in the document, not two
    delete copy.dataset.wired;  // the clone carries the original's "already wired" flag
    parts.push(copy);
    var after = frame.nextElementSibling;
    if (after && after.classList.contains('map-bar')) parts.push(after.cloneNode(true));
    inner.replaceChildren.apply(inner, parts);
    origin = window.scrollY;
    mv.setAttribute('open', '');
    document.body.classList.add('mv-open');
    if (copy.classList.contains('world-map')) {
      // A 5.8:1 world in a portrait overlay is a sliver with dead space
      // above and below. Give the enlarged copy the screen's own shape
      // and show a full-height slice you scroll sideways. Measured only
      // once the overlay is displayed -- a hidden element has no size.
      copy.classList.add('mv-world');
      copy.style.aspectRatio = '';
      copy.setAttribute('data-bounds', '0 0 1450 251');
      var wsvg = copy.querySelector('svg.map-crop');
      var box = copy.getBoundingClientRect();
      var vw = Math.min(1450, 251 * (box.width / box.height));
      wsvg.setAttribute('viewBox', ((1450 - vw) / 2).toFixed(1) + ' 0 ' + vw.toFixed(1) + ' 251');
      window.fishguideWireMap(copy);
    } else {
      window.fishguideWireMap(copy);
    }
    reset();
    history.pushState({ mapView: true }, '');
    mv.querySelector('.mv-close').focus();
  }
  function reset() { stage.style.transform = ''; stage.style.opacity = ''; }
  function close(fromPop) {
    if (!mv.hasAttribute('open')) return;
    mv.removeAttribute('open');
    document.body.classList.remove('mv-open');
    inner.replaceChildren();
    reset();
    if (origin !== null) window.scrollTo({ top: origin });
    window.dispatchEvent(new Event('fishguide:mapclosed'));
    if (!fromPop && history.state && history.state.mapView) history.back();
  }

  // Opened from each map's "Full screen" control, not by tapping the map
  // -- the map itself is draggable now and its fish are tappable.
  window.fishguideOpenMap = open;
  document.addEventListener('click', function (e) {
    if (e.target.closest('[data-mv-close]')) close();
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') close();
  });
  window.addEventListener('popstate', function () { close(true); });

  // Drag down to dismiss: the stage follows your finger so a half-swipe
  // is recoverable, and only a real commit (distance or flick) closes.
  var y0 = null, t0 = 0, dy = 0;
  stage.addEventListener('pointerdown', function (e) {
    // Anything with its own gesture or press target keeps it: the swipe
    // captures the pointer, so without this a tap on a zoom button never
    // becomes a click and a drag on the world map dismisses the view
    // instead of panning it.
    if (e.target.closest('button, .map-bar, .map-frame')) return;
    y0 = e.clientY; t0 = Date.now(); dy = 0;
    stage.style.transition = 'none';
    stage.setPointerCapture(e.pointerId);
  });
  stage.addEventListener('pointermove', function (e) {
    if (y0 === null) return;
    dy = Math.max(0, e.clientY - y0);
    stage.style.transform = 'translateY(' + dy + 'px) scale(' + (1 - Math.min(dy / 1400, 0.12)) + ')';
    stage.style.opacity = String(1 - Math.min(dy / 520, 0.72));
  });
  function end() {
    if (y0 === null) return;
    var flick = dy > 40 && (Date.now() - t0) < 300;
    stage.style.transition = '';
    if (dy > 130 || flick) { close(); } else { reset(); }
    y0 = null;
  }
  stage.addEventListener('pointerup', end);
  stage.addEventListener('pointercancel', end);
})();
</script>

<script>
// Every map in the book is the same world map, pointed somewhere. This
// wires one up: drag to pan, wheel or pinch to zoom, tap a fish for its
// card, and keep the context strip's gold box showing where you are.
(function () {
  var WORLD = [0, 0, 1450, 251];
  var pts = [];
  try { pts = JSON.parse(document.getElementById('fish-points').textContent); } catch (e) {}

  window.fishguideWireMap = function (frame) {
    if (!frame || frame.dataset.wired) return;
    frame.dataset.wired = '1';
    var svg = frame.querySelector('svg.map-crop');
    if (!svg) return;
    var home = svg.getAttribute('viewBox').split(' ').map(Number);
    var vb = home.slice();
    var ratio = home[3] / home[2];
    // the strip that belongs to this map, and the box drawn on it
    var strip = frame.previousElementSibling;
    var box = strip && strip.classList.contains('ctx') ? strip.querySelector('.ctx-box') : null;
    var link = strip && strip.classList.contains('ctx') ? strip.querySelector('.ctx-link') : null;

    function paint() {
      svg.setAttribute('viewBox', vb.map(function (n) { return +n.toFixed(2); }).join(' '));
      if (box) {
        // the gold box is where you are looking, not where the page
        // started -- it moves as you pan and resizes as you zoom
        box.setAttribute('x', vb[0].toFixed(1));
        box.setAttribute('width', vb[2].toFixed(1));
      }
      if (link) {
        var l = vb[0] / WORLD[2] * 100, r = (vb[0] + vb[2]) / WORLD[2] * 100;
        var poly = link.querySelector('polygon'), paths = link.querySelectorAll('path');
        if (poly) poly.setAttribute('points', l.toFixed(2) + ',0 ' + r.toFixed(2) + ',0 100,10 0,10');
        if (paths[0]) paths[0].setAttribute('d', 'M' + l.toFixed(2) + ' 0 L0 10');
        if (paths[1]) paths[1].setAttribute('d', 'M' + r.toFixed(2) + ' 0 L100 10');
      }
    }
    function clamp() {
      vb[2] = Math.min(WORLD[2], Math.max(90, vb[2]));
      vb[3] = Math.min(WORLD[3], vb[2] * ratio);
      vb[0] = Math.min(WORLD[2] - vb[2], Math.max(0, vb[0]));
      vb[1] = Math.min(WORLD[3] - vb[3], Math.max(0, vb[1]));
      paint();
    }
    function zoom(f, cx, cy) {
      var w = Math.min(WORLD[2], Math.max(90, vb[2] * f)), k = w / vb[2];
      vb[0] = cx - (cx - vb[0]) * k;
      vb[1] = cy - (cy - vb[1]) * k;
      vb[2] = w;
      clamp();
    }
    function user(e) {
      var p = svg.createSVGPoint();
      p.x = e.clientX; p.y = e.clientY;
      return p.matrixTransform(svg.getScreenCTM().inverse());
    }
    clamp();

    frame.addEventListener('wheel', function (e) {
      e.preventDefault();
      var u = user(e);
      zoom(e.deltaY > 0 ? 1.15 : 0.87, u.x, u.y);
    }, { passive: false });

    var drag = null, moved = 0;
    frame.addEventListener('pointerdown', function (e) {
      drag = { x: e.clientX, y: e.clientY, vx: vb[0], vy: vb[1] };
      moved = 0;
      frame.classList.add('is-dragging');
      frame.setPointerCapture(e.pointerId);
    });
    frame.addEventListener('pointermove', function (e) {
      if (!drag) return;
      var r = frame.getBoundingClientRect();
      moved = Math.max(moved, Math.abs(e.clientX - drag.x) + Math.abs(e.clientY - drag.y));
      vb[0] = drag.vx - (e.clientX - drag.x) / r.width * vb[2];
      vb[1] = drag.vy - (e.clientY - drag.y) / r.height * vb[3];
      clamp();
    });
    function end() { drag = null; frame.classList.remove('is-dragging'); }
    frame.addEventListener('pointerup', end);
    frame.addEventListener('pointercancel', end);

    // Which fish was tapped. A group's own fish are real elements, so
    // ask the DOM first -- that is exact, and it is what a reader taps
    // most. Only a fish that exists solely in the shared layer needs
    // inferring, and that is done in screen space: comparing pixels to
    // pixels can't drift the way comparing a converted point to map
    // units can.
    frame.addEventListener('click', function (e) {
      if (moved > 6) return;
      var direct = e.target.closest('.fish-marker[data-fish]');
      if (direct) {
        window.fishguideShowFish(direct.getAttribute('data-fish'), svg, pts);
        return;
      }
      var m = svg.getScreenCTM();
      if (!m) return;
      var p = svg.createSVGPoint(), best = null;
      for (var i = 0; i < pts.length; i++) {
        p.x = pts[i].x; p.y = pts[i].y;
        var q = p.matrixTransform(m);
        var d = Math.hypot(q.x - e.clientX, q.y - e.clientY);
        if (!best || d < best.d) best = { d: d, k: pts[i].k };
      }
      if (best && best.d < 26) window.fishguideShowFish(best.k, svg, pts);
    });

    var bar = frame.nextElementSibling;
    if (!bar || !bar.classList.contains('map-bar')) return;
    bar.addEventListener('click', function (e) {
      var b = e.target.closest('[data-z]');
      if (!b) return;
      var k = b.dataset.z, cx = vb[0] + vb[2] / 2, cy = vb[1] + vb[3] / 2;
      if (k === 'in') zoom(0.7, cx, cy);
      else if (k === 'out') zoom(1.45, cx, cy);
      else if (k === 'home') { vb = home.slice(); clamp(); }
      else if (k === 'world') { vb = [0, 0, WORLD[2], WORLD[2] * ratio]; clamp(); }
      else if (k === 'full' && window.fishguideOpenMap) window.fishguideOpenMap(frame);
    });
  };

  document.querySelectorAll('.map-frame').forEach(window.fishguideWireMap);
})();
</script>
<script>
// One card, shown from any map. Content comes from the JSON emitted once
// per book; the portrait is a <use> of the marker symbol already in the
// document, so a card costs no extra image bytes.
(function () {
  var data = {};
  try { data = JSON.parse(document.getElementById('fish-data').textContent); } catch (e) { return; }
  var card = document.getElementById('fish-card');
  if (!card) return;
  var el = {
    name: card.querySelector('.fc-name'), size: card.querySelector('.fc-size'),
    where: card.querySelector('.fc-where'), about: card.querySelector('.fc-about'),
    stats: card.querySelector('.fc-stats'), count: card.querySelector('.fc-count'),
    use: card.querySelector('.fc-pic use'), svg: card.querySelector('.fc-pic svg'),
    prev: card.querySelector('[data-fc="prev"]'), next: card.querySelector('[data-fc="next"]')
  };
  // Stepping moves through the group the fish belongs to -- the set the
  // reader has a cast list for beside the map.
  var byGroup = {};
  Object.keys(data).forEach(function (k) {
    (byGroup[data[k].groupId] = byGroup[data[k].groupId] || []).push(k);
  });
  var scope = [], at = -1, host = null, points = [];

  function ring(key) {
    document.querySelectorAll('.fish-sel').forEach(function (n) { n.remove(); });
    if (!key || !host) return;
    var p = null;
    for (var i = 0; i < points.length; i++) if (points[i].k === key) { p = points[i]; break; }
    if (!p) return;
    var c = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
    c.setAttribute('class', 'fish-sel');
    c.setAttribute('cx', p.x); c.setAttribute('cy', p.y); c.setAttribute('r', 13);
    host.appendChild(c);
  }
  function render(key) {
    var f = data[key];
    if (!f) return;
    el.name.textContent = f.name;
    el.size.textContent = f.size;
    el.where.textContent = f.group;
    el.about.textContent = f.about;
    el.stats.innerHTML = f.stats || '';
    el.use.setAttribute('href', '#fm-' + key);
    var sym = document.getElementById('fm-' + key);
    el.svg.setAttribute('viewBox', sym ? sym.getAttribute('viewBox') : '0 0 10 10');
    at = scope.indexOf(key);
    el.count.textContent = (at + 1) + ' of ' + scope.length + ' · ' + f.group;
    el.prev.disabled = el.next.disabled = scope.length < 2;
    card.setAttribute('open', '');
    ring(key);
  }
  window.fishguideShowFish = function (key, svg, pts) {
    host = svg; points = pts || [];
    scope = (data[key] && byGroup[data[key].groupId]) || [key];
    render(key);
  };
  function close() { card.removeAttribute('open'); ring(null); at = -1; }
  function step(d) {
    if (scope.length < 2) return;
    at = (at + d + scope.length) % scope.length;
    render(scope[at]);
  }
  card.addEventListener('click', function (e) {
    var b = e.target.closest('[data-fc]');
    if (!b) return;
    var k = b.getAttribute('data-fc');
    if (k === 'close') close(); else step(k === 'next' ? 1 : -1);
  });
  document.addEventListener('keydown', function (e) {
    if (!card.hasAttribute('open')) return;
    if (e.key === 'Escape') { close(); e.stopPropagation(); }
    if (e.key === 'ArrowRight') step(1);
    if (e.key === 'ArrowLeft') step(-1);
  }, true);
  window.addEventListener('fishguide:mapclosed', close);
})();
</script>
</body>
</html>
