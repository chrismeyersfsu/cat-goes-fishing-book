<div class="page">
  <div class="tape"></div>
  <div class="banner">
    <div><h2>The World</h2><div class="sub">Full Map · Every Zone at a Glance</div></div>
  </div>
  <div class="l3-body">
    <div class="map-frame world-map" id="world-map" style="aspect-ratio:{{ view_box_w }}/251;">
      <svg class="map-crop" viewBox="{{ view_box }}" preserveAspectRatio="xMidYMid slice" role="img" aria-label="The complete Cat Goes Fishing world map with every fish marked, from the Shore to the furthest distance a tech boat can go">
<use href="#mapTerrain"/>
{{ map_markers }}
</svg>
    </div>
    <div class="world-bar">
      <span class="world-hint">Drag to pan &middot; scroll or pinch to zoom &middot; tap a fish</span>
      <span class="world-zoom">
        <button type="button" data-world="out" aria-label="Zoom out">&minus;</button>
        <button type="button" data-world="in" aria-label="Zoom in">+</button>
        <button type="button" data-world="reset">Reset</button>
      </span>
    </div>
    <p class="desc" style="margin-top:14px;">Every fish in the book is marked here. Drag to move around, zoom in on a crowded stretch, and tap any fish for its card. Each group's own page later zooms in on a slice of this same map.</p>
  </div>
</div>
