{% import "partials/badges.html.j2" as m %}
<div class="page" id="group-{{ group.id }}">
  <div class="tape"></div>
  <div class="banner">
    <div><h2>{{ group.title }}</h2><div class="sub">{{ group.subtitle }}</div></div>
    <div class="badge-col">{{ m.badges(group) }}</div>
  </div>
  <div class="cast-strip">🎯 <b>Cast:</b>&nbsp; {{ group.cast }}</div>
  <div class="l2-body">
    <div class="l2-map">{{ context_strip }}<div class="map-frame" style="{{ map_frame_style }}">
      <svg class="map-crop" viewBox="{{ group.view_box }}" preserveAspectRatio="xMidYMid slice" role="img" aria-label="{{ group.map_alt }}">
<use href="#mapTerrain"/>
{{ map_markers }}
</svg>
    </div>
    <div class="map-bar">
      <span class="map-hint">Drag &middot; scroll to zoom &middot; tap a fish</span>
      <span class="map-zoom">
        <button type="button" data-z="out" aria-label="Zoom out">&minus;</button>
        <button type="button" data-z="in" aria-label="Zoom in">+</button>
        <button type="button" data-z="home">Focus</button>
        <button type="button" data-z="world">Whole map</button>
        <button type="button" data-z="full">Full screen</button>
      </span>
    </div></div>
    <h3 class="section-h">About</h3>
    <p class="desc" style="margin-bottom:14px;">{{ group.about }}</p>
    <div class="duo-grid">
      {% for f in group.fish %}
      <div class="duo-card">
        <div class="fish-pic">{{ fish_pic(f) }}</div><div class="who"><h4>{{ f.name }}</h4></div>
        <p>{{ f.about }}</p>
        <div class="stat-row">{{ m.stat_row(f.stats) }}</div>
      </div>
      {% endfor %}
    </div>
    {% if group.special_instructions %}
    <h3 class="section-h" style="margin-top:16px;">Special Instructions</h3>
    <p class="instr">{{ group.special_instructions }}</p>
    {% endif %}
    <div class="shared-gear">
      <h3 class="section-h">Gear Up (shared)</h3>
      <ul class="gear-list">
        {{ m.gear_list(group.shared_gear) }}
      </ul>
    </div>
    {% include "partials/back_to_top.html.j2" %}
  </div>
</div>
